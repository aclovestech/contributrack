# PostgreSQL connection used by server-side Drizzle queries.
DATABASE_URL=postgresql://user:password@localhost:5432/contributrack

# StackAuth values. The publishable client key and project id are safe to use
# in the browser; keep the server key private.
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# Secret used to verify StackAuth user lifecycle webhooks.
STACK_AUTH_WEBHOOK_SECRET=

# Optional StackAuth endpoint overrides. Leave unset for the default service.
# NEXT_PUBLIC_STACK_API_URL=
# NEXT_PUBLIC_STACK_EXTRA_REQUEST_HEADERS={}
