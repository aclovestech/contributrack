{
  "name": "contributrack",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": "1.10.0",
      "js-cookie": "3.0.8",
      "browserslist": "4.29.0",
      "bn.js": "4.12.5"
    }
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/check-env.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "format:check": "prettier --check 'actions/**/*.ts' 'app/**/*.{ts,tsx,css}' 'components/**/*.tsx' 'lib/**/*.ts' 'src/**/*.ts' 'types/**/*.ts' 'tests/**/*.ts' 'scripts/**/*.mjs' '.github/**/*.yml' '*.md' 'docs/**/*.md' '.env.example' 'package.json' 'eslint.config.mjs' 'next.config.ts' 'drizzle.config.ts'",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@stackframe/stack": "^2.8.58",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.562.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "pdfmake": "^0.3.2",
    "pg": "^8.17.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.71.1",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "svix": "^1.84.1",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.9",
    "@types/pg": "^8.16.0",
    "@types/pdfmake": "^0.2.12",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
